{
  "name": "habit-tracker-mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/habit-tracker-mobile/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project habit-tracker-mobile --web",
  "targets": {
    "start": {
      "executor": "@nx/expo:start",
      "dependsOn": ["sync-deps"],
      "options": {}
    },
    "export": {
      "executor": "@nx/expo:export",
      "options": {
        "platform": "all",
        "outputDir": "../../dist/apps/habit-tracker-mobile"
      }
    },
    "prebuild": {
      "executor": "@nx/expo:prebuild",
      "options": {}
    },
    "build-ios": {
      "executor": "@nx/expo:build",
      "options": {
        "platform": "ios"
      }
    },
    "build-android": {
      "executor": "@nx/expo:build",
      "options": {
        "platform": "android"
      }
    },
    "submit": {
      "executor": "@nx/expo:submit",
      "options": {}
    },
    "build-list": {
      "executor": "@nx/expo:build-list",
      "options": {}
    },
    "update": {
      "executor": "@nx/expo:update",
      "options": {}
    },
    "sync-deps": {
      "executor": "@nx/expo:sync-deps",
      "options": {}
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/habit-tracker-mobile/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/habit-tracker-mobile/jest.config.ts"
      }
    }
  }
}
