{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "jsx": "react-native",
    "noEmit": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["jest", "node"]
  },
  "include": ["src", "*.ts", "*.js"],
  "exclude": ["node_modules"]
}
